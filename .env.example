# Core
APP_ENV=development
APP_BASE_URL=http://localhost:8501
DATABASE_URL=sqlite:///data/reality_spread.db
SESSION_SECRET=replace-with-a-long-random-value

# Admin authentication (recommended)
PPI_ADMIN_USERNAME=admin
# Generate with: python scripts/hash_password.py
PPI_ADMIN_PASSWORD_HASH=
# Development-only fallback; do not use in production.
PPI_ADMIN_PASSWORD=
DATABASE_URL=sqlite:///data/ppi_visual_test.db
# Polymarket public APIs
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com

# Evidence collection
GDELT_ENABLED=false
SOURCE_TIMEOUT_SECONDS=20
SOURCE_MAX_RETRIES=3
SOURCE_USER_AGENT=PPIResearch/1.0
SAFE_SOURCE_SCHEMES=https
# Optional comma-separated allowlist. Leave blank to use built-in SSRF protections.
ALLOWED_SOURCE_DOMAINS=

# LLM classification: deterministic, ollama, or openai_compatible
LLM_PROVIDER=deterministic
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

# OpenRouter: a separate, explicitly-versioned comparison model series (pinned to
# deepseek/deepseek-v4-flash-0731), never the primary Qwen/Ollama series above. Get a key at
# https://openrouter.ai/settings/keys. In GitHub Actions this is the OPENROUTER_API_KEY secret,
# never a repo variable or committed value -- see docs/research/OPENROUTER_INTEGRATION.md.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_OUTPUT_TOKENS=2048

# Scheduling
# Canonical schedule is 09:00 / 21:00 America/Toronto, via GitHub Actions' native per-entry
# `timezone: America/Toronto` schedule field (see .github/workflows/ppi-daily.yml). The
# *_RUN_HOUR_UTC values below are the EDT-equivalent UTC hours; the pipeline's +/-2h
# slot-classification tolerance absorbs the 1h EST shift automatically. See
# docs/SELF_HOSTED_RUNNER.md for the full scheduling design.
APP_STALE_HOURS=30
PRIMARY_RUN_HOUR_UTC=13
BACKUP_RUN_HOUR_UTC=1
SCHEDULER_TIMEZONE=America/Toronto

# Optional alerts
DISCORD_WEBHOOK_URL=

# Existing optional adapters
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_API_KEY=
KALSHI_API_SECRET=
PREDICTIT_MARKETDATA_URL=https://www.predictit.org/api/marketdata/all/
FEC_API_KEY=
VOTEHUB_API_KEY=
COOK_EMAIL=
COOK_PASSWORD=
