# Core
APP_ENV=development
APP_BASE_URL=http://localhost:8501
DATABASE_URL=sqlite:///data/reality_spread.db
SESSION_SECRET=replace-with-a-long-random-value

# Admin authentication (recommended)
PPI_ADMIN_USERNAME=admin
# Generate with: python scripts/hash_password.py
PPI_ADMIN_PASSWORD_HASH=
# Development-only fallback; do not use in production.
PPI_ADMIN_PASSWORD=
DATABASE_URL=sqlite:///data/ppi_visual_test.db
# Polymarket public APIs
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com

# Evidence collection
GDELT_ENABLED=false
SOURCE_TIMEOUT_SECONDS=20
SOURCE_MAX_RETRIES=3
SOURCE_USER_AGENT=PPIResearch/1.0
SAFE_SOURCE_SCHEMES=https
# Optional comma-separated allowlist. Leave blank to use built-in SSRF protections.
ALLOWED_SOURCE_DOMAINS=

# LLM classification: deterministic, ollama, or openai_compatible
LLM_PROVIDER=deterministic
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

# OpenRouter: a separate, explicitly-versioned comparison model series (pinned to
# deepseek/deepseek-v4-flash-0731), never the primary Qwen/Ollama series above. Get a key at
# https://openrouter.ai/settings/keys. In GitHub Actions this is the OPENROUTER_API_KEY secret,
# never a repo variable or committed value -- see docs/research/OPENROUTER_INTEGRATION.md.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_OUTPUT_TOKENS=2048

# Scheduling
# Canonical schedule is 09:00 / 21:00 America/Toronto, via GitHub Actions' native per-entry
# `timezone: America/Toronto` schedule field (see .github/workflows/ppi-daily.yml). The
# *_RUN_HOUR_UTC values below are the EDT-equivalent UTC hours; the pipeline's +/-2h
# slot-classification tolerance absorbs the 1h EST shift automatically. See
# docs/SELF_HOSTED_RUNNER.md for the full scheduling design.
APP_STALE_HOURS=30
PRIMARY_RUN_HOUR_UTC=13
BACKUP_RUN_HOUR_UTC=1
SCHEDULER_TIMEZONE=America/Toronto

# Optional alerts
DISCORD_WEBHOOK_URL=

# Existing optional adapters
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_API_KEY=
KALSHI_API_SECRET=
PREDICTIT_MARKETDATA_URL=https://www.predictit.org/api/marketdata/all/
FEC_API_KEY=
VOTEHUB_API_KEY=
COOK_EMAIL=
COOK_PASSWORD=

# --- PPI Quant v1.5 -------------------------------------------------------------------------------
# Deterministic quantitative election-forecasting engine (app/quant). The Quant math itself needs
# no keys and no network -- it runs on ingested structured data. Shadow mode writes quant_forecasts
# without changing the headline series; flip to true once you have verified its output.
QUANT_SHADOW_ENABLED=false
QUANT_METHODOLOGY_VERSION=ppi-quant-v1.0
ENSEMBLE_METHODOLOGY_VERSION=ppi-ensemble-v1.5

# Which series is the PUBLIC HEADLINE fair value. Stays legacy_blind_llm until the v1.5 pipeline
# passes the checklist in docs/research/PPI_CUTOVER.md; the flip is then this one line.
# Values: legacy_blind_llm | quant | ensemble
PPI_HEADLINE_SERIES=legacy_blind_llm
# Gate the twice-daily v1.5 orchestrator (scripts/run_v15_daily.py / ppi-v15-daily.yml).
V15_PIPELINE_ENABLED=false

# Independent blind-benchmark forecasters -- GPT (spec 23) + Claude (spec 24). Separate series,
# never mixed into the Quant probability, never shown the market price / Quant value / each other.
# Optional: no key (or `pip install -r requirements-blind.txt` not run) -> explicit
# SKIPPED_PROVIDER row, never a fabricated value. Server-side only -- never shipped to the browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BLIND_MODEL=gpt-5
ANTHROPIC_BLIND_MODEL=claude-opus-5
BLIND_METHODOLOGY_VERSION=ppi-blind-v1
BLIND_PROMPT_VERSION=blind_benchmark_v1
BLIND_MAX_RETRIES=2
BLIND_MAX_WEB_SEARCHES=3
BLIND_REQUEST_TIMEOUT_SECONDS=120

# --- Provider / data-acquisition layer (app/providers) -----------------------------------------
# The Quant engine runs on ingested structured data (make ingest). With NO keys configured the
# chains degrade gracefully: seed CSVs for state lean, offline seed-file chains for polls, and
# explicit STALE / EMPTY statuses -- never a fabricated or zeroed value.
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BACKOFF_SECONDS=1.0
PROVIDER_CACHE_TTL_MINUTES=360
RACE_MATCH_MIN_CONFIDENCE=0.75
MARKET_CLASSIFY_MIN_CONFIDENCE=0.80

# Run `PYTHONPATH=. python scripts/check_providers.py` to see, per provider, whether it is
# enabled and (with --probe) whether its endpoint is reachable with the config below.

# --- Decision Desk HQ (the spec's "Decision Labs") -----------------------------------------------
# Polling API -- race polls + generic ballot. PUBLIC, no auth. Endpoints:
#   GET https://polling.decisiondeskhq.com/api/v1/polls/ballot_test      (trial-heat race polls)
#   GET https://polling.decisiondeskhq.com/api/v1/polls/generic_ballot   (generic congressional)
# Docs: https://polling-api-docs.decisiondeskhq.com
DECISIONDESK_POLLING_BASE_URL=https://polling.decisiondeskhq.com
#
# Results API v4 -- historical presidential results -> state partisan lean (the main data-quality
# lever; see docs/OPERATIONS_V15.md section 4). Endpoint: GET /api/v4/race-calls.
# OAuth2 client-credentials: POST https://resultsapi.decisiondeskhq.com/api/v4/oauth/token with
# {client_id, client_secret, grant_type:"client_credentials"} -> short-lived bearer.
# Request API access via https://www.decisiondeskhq.com/products ; docs https://docs.decisiondeskhq.com
# Leave the id/secret blank to stay on the committed seed CSVs (polling-only degraded mode).
DECISIONDESK_RESULTS_BASE_URL=https://resultsapi.decisiondeskhq.com
DECISIONDESK_CLIENT_ID=
DECISIONDESK_CLIENT_SECRET=
# Optional: a pre-issued static bearer to use INSTEAD of the client-credentials exchange above.
DECISIONDESK_API_KEY=

# --- VoteHub polls API (preferred national-environment provider) -------------------------------
# PUBLIC, CC-BY-4.0, no key required. GET https://api.votehub.com/polls?poll_type=generic-ballot
# Docs: https://votehub.com/polls/api/ . VOTEHUB_API_KEY is sent as a bearer only if you set it.
VOTEHUB_API_BASE_URL=https://api.votehub.com
VOTEHUB_API_KEY=

# --- OpenFEC -- federal (Senate) candidate identity / incumbency ------------------------------
# Free key: https://api.data.gov/signup/ . Without FEC_API_KEY this provider is disabled and
# Senate candidates come from market discovery + the web fallback only.
OPENFEC_BASE_URL=https://api.open.fec.gov/v1
# FEC_API_KEY is set in the "Existing optional adapters" block above.

# --- PollingSource: a GENERIC secondary poll API (spec section 6) -----------------------------
# No canonical vendor -- point this at any service that returns individual poll records as JSON
# at {base}/polls and {base}/generic-ballot. Blank -> disabled (DDHQ + web fallback still run).
POLLINGSOURCE_API_BASE_URL=
POLLINGSOURCE_API_KEY=

# --- LLM API bases ---------------------------------------------------------------------------
# Leave blank to use each SDK's default (https://api.openai.com/v1 , https://api.anthropic.com).
# Override only for an Azure / proxy / gateway deployment.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
